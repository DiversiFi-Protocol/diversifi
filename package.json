    "@types/node": "20.19.43",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
